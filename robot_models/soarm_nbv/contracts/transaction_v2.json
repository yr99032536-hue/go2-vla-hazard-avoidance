{
  "contract": "smolvla_policy_transaction",
  "version": 2,
  "status": "phase0_contract_only",
  "runtime_active": false,
  "transport": {
    "pattern": "ZMQ REQ/REP",
    "client_owner": "go2_active_slam.policy_bridge_node.PolicyBridgeNode",
    "server_owner": "soarm_nbv.smolvla_policy_runner.PolicyTransactionServer",
    "socket_options": {
      "LINGER": 0
    },
    "one_in_flight_request": true,
    "client_may_send": [
      "RESET2",
      "OBS2"
    ],
    "client_may_receive": [
      "READY2",
      "ACT2",
      "ERR2"
    ],
    "forbidden_owners": [
      "Isaac",
      "go2_soarm active mode",
      "supervisor_node",
      "any arm application component"
    ]
  },
  "identity": {
    "protocol_version": 2,
    "uuid_encoding": "16 raw bytes",
    "required_correlation": [
      "request_uuid",
      "snapshot_uuid",
      "episode_id",
      "decision_epoch",
      "map_revision",
      "target_revision",
      "deadline_ns"
    ],
    "runner_generation": "uint32",
    "reset_counter": "uint64 monotonically increasing per runner generation",
    "request_uuid_reuse": "forbidden",
    "causal_pair": "each member uses a separate snapshot_uuid, request_uuid, and RESET2"
  },
  "frames": {
    "RESET2": {
      "direction": "bridge_to_runner",
      "order": 1,
      "runner_effect": "Validate identities and deadline, call public policy.reset() exactly once for this independent request, increment reset_counter, then reply READY2."
    },
    "READY2": {
      "direction": "runner_to_bridge",
      "order": 2
    },
    "OBS2": {
      "direction": "bridge_to_runner",
      "order": 3,
      "runner_effect": "Validate freshness and READY2 correlation; strip every metadata/control field before inference; construct exactly camera1, camera2, camera3, state, and task; invoke unchanged standard processors and select_action."
    },
    "ACT2": {
      "direction": "runner_to_bridge",
      "order": 4
    },
    "ERR2": {
      "direction": "runner_to_bridge",
      "may_replace": [
        "READY2",
        "ACT2"
      ]
    }
  },
  "deadlines": {
    "minimum_remaining_on_bridge_accept_ns": 1000000,
    "warning_ns": 250000000,
    "hard_transaction_ns": 400000000,
    "proposal_max_age_ns": 100000000,
    "timeout_effect": "ERR result, socket recreation, cached snapshot invalidation, and supervisor HOLD"
  },
  "restart_and_stale_behavior": {
    "triggers": [
      "READY2 or ACT2 mismatch",
      "REP restart or generation change",
      "hard deadline",
      "action cancellation",
      "mode change",
      "revision change",
      "malformed payload",
      "bridge deactivation"
    ],
    "effect": "Close and recreate REQ socket, invalidate cached snapshot, return typed failure, and require supervisor HOLD.",
    "retry": "Never retry the same request.",
    "recovery": "Requires a new settled snapshot UUID, a new request UUID, and a new RESET2/READY2 handshake.",
    "generation": "Any in-flight result from an earlier runner_generation is stale and returns RUNNER_RESTART."
  },
  "black_box_boundary": {
    "model_input_keys": [
      "camera1",
      "camera2",
      "camera3",
      "state",
      "task"
    ],
    "model_output": "exactly seven-motor float32 proposal",
    "metadata_never_in_model_dictionary": [
      "request_uuid",
      "snapshot_uuid",
      "episode_id",
      "decision_epoch",
      "map_revision",
      "target_revision",
      "deadline_ns",
      "hashes",
      "generations",
      "reset_counter",
      "authorization",
      "trajectory",
      "acknowledgment"
    ],
    "unchanged_model_contract": true
  },
