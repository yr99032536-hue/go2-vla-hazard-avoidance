        [
          "velocity_external_deg_s",
          "float32[7]"
        ],
        [
          "acceleration_external_deg_s2",
          "float32[7]"
        ]
      ],
      "serialized_bytes": 92,
      "constraints": [
        "time_from_start_ns strictly increases",
        "time_from_start_ns > 0",
        "time_from_start_ns <= 5000000000",
        "every float finite"
      ]
    },
    "apply_trajectory_invariants": [
      "points length is 1..128",
      "last points.position_external_deg byte-exactly equals validated_target_external_deg",
      "validated_target_external_deg byte-exactly equals authorized target carried by ArmApplicationAck on COMPLETED",
      "SHA-256 path digest and HMAC must verify before authorization consumption"
    ]
  },
