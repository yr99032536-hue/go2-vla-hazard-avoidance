      "path_sha256 = SHA-256(path_hash_preimage)",
      "construct full ApplyArmTrajectory goal by inserting path_sha256",
      "serialize apply_goal_hmac_preimage from that goal excluding only authorization_hmac_sha256 with recomputed field_count",
      "authorization_hmac_sha256 = RFC2104 HMAC-SHA256(apply_goal_hmac_preimage)",
      "serialize result and compute result_payload_sha256 = SHA-256(result)",
      "construct ack with result_payload_sha256; verify result/ack and target/path equivalence"
    ]
  }
