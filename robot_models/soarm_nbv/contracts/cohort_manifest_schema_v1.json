{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cohort_manifest_schema_v1.json",
  "title": "Immutable SO-ARM NBV cohort manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "cohort", "created_at_utc", "source_root", "entries", "renderer_version", "schema_contract_version", "scene_version", "codec", "task_template_id", "ledger_version", "immutable", "signing"],
  "properties": {
    "schema_version": {"const": "cohort_manifest_v1"}, "manifest_id": {"$ref": "#/$defs/id"}, "cohort": {"enum": ["train", "validation", "fixed_stage2", "representative_stage3", "unseen_stage4"]}, "created_at_utc": {"type": "string", "format": "date-time"}, "source_root": {"type": "string", "pattern": "^/[A-Za-z0-9._/-]+$", "minLength": 1, "maxLength": 512}, "renderer_version": {"const": "guidance_renderer_v1"}, "schema_contract_version": {"const": "schema_contract_v2"}, "scene_version": {"type": "string", "minLength": 1, "maxLength": 128}, "task_template_id": {"type": "string", "minLength": 1, "maxLength": 128}, "ledger_version": {"type": "string", "minLength": 1, "maxLength": 128}, "immutable": {"const": true},
    "codec": {"$ref": "#/$defs/codec"},
    "signing": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "signed_fields", "public_key_id", "signature_base64"], "properties": {"algorithm": {"const": "Ed25519"}, "canonicalization": {"const": "RFC 8785 JCS UTF-8"}, "signed_fields": {"const": "all top-level fields except signing.signature_base64"}, "public_key_id": {"$ref": "#/$defs/id"}, "signature_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "minLength": 86, "maxLength": 88}}},
    "stage4_write_once": {"type": "object", "additionalProperties": false, "required": ["committed_before_training", "exposure_status", "replacement_policy"], "properties": {"committed_before_training": {"const": true}, "exposure_status": {"enum": ["unexposed", "exposed"]}, "replacement_policy": {"const": "original manifest remains observed; tuning requires a new fresh-confirmation manifest"}}},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "allOf": [{"if": {"properties": {"cohort": {"const": "unseen_stage4"}}}, "then": {"required": ["stage4_write_once"]}, "else": {"not": {"required": ["stage4_write_once"]}}}],
  "x-external-validator": {"required": ["entry.split equals top-level cohort", "entry.source_path is a relative POSIX path confined by resolved containment to source_root; no absolute path, empty segment, '.' or '..'", "unique episode_id within and across supplied manifests", "unique (scene_family, seed, scene_manifest_sha256) across supplied manifests", "all entries have exclusion_status='included'; legacy_room_clone_camera3 and mislabeled_custom_leader are quarantine-only and never supplied as entries", "verify Ed25519 signature against public_key_id over RFC 8785 JCS UTF-8 bytes with signing.signature_base64 omitted", "manifests are write-once after signature; unseen_stage4 must be signed before training and its original observed cohort remains immutable after exposure"]},
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "codec": {"type": "object", "additionalProperties": false, "required": ["video_codec", "pixel_format", "crf", "decoder_backend"], "properties": {"video_codec": {"const": "libsvtav1"}, "pixel_format": {"const": "yuv420p"}, "crf": {"const": 30}, "decoder_backend": {"const": "torchcodec"}}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["episode_id", "scene_family", "seed", "split", "source_path", "scene_manifest_sha256", "renderer_version", "schema_contract_version", "scene_version", "png_sha256", "label_ledger_sha256", "task_template_id", "codec", "ledger_version", "exclusion_status"], "properties": {"episode_id": {"$ref": "#/$defs/id"}, "scene_family": {"type": "string", "minLength": 1, "maxLength": 128}, "seed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "split": {"enum": ["train", "validation", "fixed_stage2", "representative_stage3", "unseen_stage4"]}, "source_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"}, "scene_manifest_sha256": {"$ref": "#/$defs/sha256"}, "renderer_version": {"const": "guidance_renderer_v1"}, "schema_contract_version": {"const": "schema_contract_v2"}, "scene_version": {"type": "string", "minLength": 1, "maxLength": 128}, "png_sha256": {"type": "object", "additionalProperties": false, "required": ["wrist", "front", "guidance"], "properties": {"wrist": {"$ref": "#/$defs/sha256"}, "front": {"$ref": "#/$defs/sha256"}, "guidance": {"$ref": "#/$defs/sha256"}}}, "label_ledger_sha256": {"$ref": "#/$defs/sha256"}, "task_template_id": {"type": "string", "minLength": 1, "maxLength": 128}, "codec": {"$ref": "#/$defs/codec"}, "ledger_version": {"type": "string", "minLength": 1, "maxLength": 128}, "exclusion_status": {"const": "included"}}}
  }
}
